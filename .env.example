# ---- Common
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (Supabase PostgreSQL)
# Pooler (transaction mode, port 6543) for the running app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idrok?schema=public
# Direct connection (port 5432) — migrations only.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/idrok?schema=public
DATABASE_POOL_MAX=5

# ---- Redis (Render Key Value; maxmemory-policy must be noeviction)
REDIS_URL=redis://localhost:6379

# ---- API
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API (Render: 1) — needed for the client IP in login rate limits.
TRUST_PROXY=0
# Access-token signing key, at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Parent domain shared by app.<domain> and api.<domain>; leave empty locally.
COOKIE_DOMAIN=
# false only for local http development.
COOKIE_SECURE=false
DEFAULT_TENANT_SLUG=idrok

# ---- Seed (pnpm --filter @idrok/api seed)
SEED_SCHOOL_NAME=Idrok

# ---- Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
