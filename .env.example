# Copy to .env and fill in. Only names and descriptions live here — never real values (security-baseline.md S3).
# Secrets (no defaults, the API refuses to start without them): DATABASE_URL, REDIS_URL, JWT_SECRET.

# ---- Common
# development | test | production
NODE_ENV=
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=

# ---- Database (Supabase PostgreSQL)
# SECRET. App connection: Supabase pooler, transaction mode, port 6543, with ?pgbouncer=true
DATABASE_URL=
# SECRET. Direct connection, port 5432 — migrations only
DIRECT_URL=
# Max connections per process (instances × value must stay under the pooler limit; default 5)
DATABASE_POOL_MAX=

# ---- Redis (Render Key Value; maxmemory-policy must be noeviction)
# SECRET. redis://… or rediss://…
REDIS_URL=

# ---- API
# Port to listen on (default 4000)
PORT=
# Comma-separated web origins allowed to call the API, e.g. the app.<domain> URL
CORS_ORIGINS=
# Number of proxies in front of the API: 0 locally, 1 on Render — see docs/DEPLOY.md
TRUST_PROXY=
# SECRET. Access-token signing key, at least 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Access token lifetime in seconds (default 900)
ACCESS_TOKEN_TTL_SECONDS=
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=
# Parent domain shared by app.<domain> and api.<domain>; empty locally
COOKIE_DOMAIN=
# true in every deployed environment; false only for local http development (default true)
COOKIE_SECURE=
# School slug used when a login request names none (default idrok)
DEFAULT_TENANT_SLUG=

# ---- Files (StorageProvider)
# local | supabase (default local)
STORAGE_DRIVER=
# Directory for the local driver (default .data/storage)
STORAGE_LOCAL_DIR=
# Supabase project URL (supabase driver)
SUPABASE_URL=
# SECRET (supabase driver). Service role key — server only, never shipped to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name (default idrok-files)
SUPABASE_STORAGE_BUCKET=

# ---- Passwords
# argon2id memory cost in KiB; keep the default 19456 (OWASP minimum) everywhere except automated tests
ARGON2_MEMORY_KIB=

# ---- Seed (pnpm --filter @idrok/api seed; interactive terminal only)
# Display name of the school created by the seed
SEED_SCHOOL_NAME=

# ---- Web (read at runtime, so one build serves every environment)
# API base URL as seen from the browser, ending in /api/v1 (e.g. https://api.<domain>/api/v1)
API_PUBLIC_URL=
# API base URL for the web server itself (Render private network); defaults to API_PUBLIC_URL
API_INTERNAL_URL=
# School slug whose branding the web app shows (default: the API's DEFAULT_TENANT_SLUG)
TENANT_SLUG=
