// Idrok System — M1–M5 data model DRAFT (M0).
// Bu fayl faqat qoralama: migratsiya yaratilmaydi. Tasdiqlangandan keyin packages/db/prisma/schema.prisma ga
// bosqichma-bosqich ko'chiriladi (har bosqich faqat o'z modellarini qo'shadi).
//
// Konvensiyalar (docs/architecture/data-model.md §1):
// - id: UUID. Har tenant-scoped jadvalda tenantId (FK → Tenant) bor; tenantId serverda auth kontekstidan qo'yiladi.
// - Vaqt nuqtalari: timestamptz (UTC). Kunga bog'liq yozuvlar: schoolDate (date), Asia/Tashkent bo'yicha serverda.
// - Ball/foiz: Decimal. Coin: Int (butun birlik). Float yo'q.
// - Ledger jadvallar (ScoreEntry, CoinTransaction) — faqat INSERT. Tuzatish = REVERSAL/CORRECTION yozuv.
// - Prisma ifodalay olmaydigan invariantlar (partial unique, CHECK) "SQL:" izohi bilan belgilangan; ular migratsiya
//   SQL'ida yoziladi va integration test bilan tekshiriladi (data-model.md §8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

