    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.5.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "multer": "2.5.0",
    "pg": "8.23.1",
