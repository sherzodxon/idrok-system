// Idrok System — database schema. Only models of finished stages live here; the full M1–M5 draft is
// docs/architecture/schema.draft.prisma. Rules (docs/architecture/data-model.md §1):
// - UUID ids; every tenant-scoped table has tenantId (FK → Tenant); tenantId comes from the auth context only.
// - Instants are timestamptz (UTC); calendar days are `date` (school date, Asia/Tashkent, computed on the server).
// - Invariants Prisma cannot express (partial unique, CHECK, EXCLUDE, append-only triggers) live in migration SQL and
//   are listed in packages/db/INVARIANTS.md; a test verifies they exist.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================================================================
// ENUMS
// =====================================================================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum Density {
  COMFORTABLE
  COMPACT
}

enum Locale {
  uz
  ru
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClientType {
  WEB
  MOBILE
  TELEGRAM
}

enum FileKind {
  IMPORT_SOURCE
  EXPORT
  STUDENT_PHOTO
  BRANDING
  OTHER
  QUESTION_IMAGE
  PRODUCT_IMAGE
  FACE_PHOTO
}

enum FileStatus {
  PENDING
  READY
  DELETED
}

enum ImportKind {
  STUDENTS_GUARDIANS
  EMPLOYEES_ASSIGNMENTS
  CLASS_GROUPS
  SUBJECTS
  CURRICULUM_PLAN
  QUESTIONS
}

enum ImportStatus {
  UPLOADED
  PARSING
  PREVIEW_READY
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  OK
  WARNING
  ERROR
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TeachingGroupKind {
  CLASS
  SUBGROUP
  CROSS_CLASS
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  LEFT
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum GuardianRelation {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  LEFT
  GRADUATED
  CANCELLED
}

enum AcademicPeriodType {
  QUARTER
  HALF
  YEAR
  CUSTOM
}

enum AcademicPeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CalendarDayKind {
  HOLIDAY
  VACATION
  NON_WORKING
  WORKING_OVERRIDE
  SHORTENED
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WeekType {
  ALL
  ODD
  EVEN
}

enum LessonSessionStatus {
  SCHEDULED
  HELD
  CANCELLED
  MOVED
}

enum LessonSessionSource {
  TIMETABLE
  MANUAL
}

enum CurriculumPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum PlanAssignmentStatus {
  ACTIVE
  SUPERSEDED
  REMOVED
}

enum LessonType {
  NEW
  PRACTICE
  REVIEW
  CONTROL_WORK
  BSB
  CHSB
  LAB
  OTHER
}

// =====================================================================================================================
// TENANT, SETTINGS, BRANDING
// =====================================================================================================================

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  settings SchoolSettings?
  branding SchoolBranding?

  users                    User[]
  authSessions             AuthSession[]
  roles                    Role[]
  userRoles                UserRole[]
  auditLogs                AuditLog[]
  fileAssets               FileAsset[]
  importJobs               ImportJob[]
  idempotencyRecords       IdempotencyRecord[]
  outboxEvents             OutboxEvent[]
  academicYears            AcademicYear[]
  grades                   Grade[]
  classGroups              ClassGroup[]
  teachingGroups           TeachingGroup[]
  teachingGroupMembers     TeachingGroupMember[]
  subjects                 Subject[]
  employees                Employee[]
  teacherAssignments       TeacherAssignment[]
  students                 Student[]
  guardians                Guardian[]
  studentGuardians         StudentGuardian[]
  studentEnrollments       StudentEnrollment[]
  academicPeriods          AcademicPeriod[]
  schoolWeeks              SchoolWeek[]
  calendarDays             CalendarDay[]
  shifts                   Shift[]
  bellSchedules            BellSchedule[]
  rooms                    Room[]
  timetables               Timetable[]
  timetableEntries         TimetableEntry[]
  lessonSessions           LessonSession[]
  topics                   Topic[]
  curriculumPlans          CurriculumPlan[]
  planItems                PlanItem[]
  planAssignments          PlanAssignment[]
  scoreCriteria            ScoreCriterion[]
  lessonAttendance         LessonAttendance[]
  scoreEntries             ScoreEntry[]
  scoreLimitRules          ScoreLimitRule[]
  scoreSettings            ScoreSettings?
  assessmentPolicies       AssessmentPolicy[]
  assessmentPolicyVersions AssessmentPolicyVersion[]
  policyBindings           PolicyBinding[]
  gradeScales              GradeScale[]
  manualAssessmentScores   ManualAssessmentScore[]
  periodResults            PeriodResult[]
  periodCloseRuns          PeriodCloseRun[]

  testTypes           TestType[]
  questions           Question[]
  questionVersions    QuestionVersion[]
  tests               Test[]
  testQuestions       TestQuestion[]
  testAssignments     TestAssignment[]
  testWindowOverrides TestWindowOverride[]
  testAttempts        TestAttempt[]
  testAnswers         TestAnswer[]
  testEvents          TestEvent[]
  offlineResults      OfflineResult[]

  coinSettings          CoinSettings?
  coinCriteria          CoinCriterion[]
  coinCriterionTeachers CoinCriterionTeacher[]
  coinLimitRules        CoinLimitRule[]
  coinAccounts          CoinAccount[]
  coinTransactions      CoinTransaction[]
  coinProducts          CoinProduct[]
  coinOrders            CoinOrder[]
  coinAutoRules         CoinAutoRule[]

  attendanceSettings AttendanceSettings?
  latenessBands      LatenessBand[]
  bridgeAgents       BridgeAgent[]
  devices            Device[]
  accessEvents       AccessEvent[]
  attendanceRecords  AttendanceRecord[]
  faceProfiles       FaceProfile[]
  faceSyncJobs       FaceSyncJob[]
  bridgeJobs         BridgeJob[]
}

model SchoolSettings {
  id                     String   @id @default(uuid(7)) @db.Uuid
  tenantId               String   @unique @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timezone               String   @default("Asia/Tashkent")
  defaultLocale          Locale   @default(uz)
  enabledLocales         Locale[] @default([uz, ru])
  currency               String   @default("UZS")
  weekStartsOn           Int      @default(1)
  studentCodePrefix      String   @default("STD")
  studentAccountMinGrade Int      @default(5) // Q-27: import creates logins from this grade level up
  planApprovalRequired   Boolean  @default(true)
  maxQuestionsPerTest    Int      @default(50) // Q-36; SQL: SchoolSettings_max_questions_check
  updatedById            String?  @db.Uuid
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model SchoolBranding {
  id                    String     @id @default(uuid(7)) @db.Uuid
  tenantId              String     @unique @db.Uuid
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schoolName            String
  platformName          String     @default("Idrok System")
  logoAssetId           String?    @db.Uuid
  logoAsset             FileAsset? @relation("BrandingLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  faviconAssetId        String?    @db.Uuid
  faviconAsset          FileAsset? @relation("BrandingFavicon", fields: [faviconAssetId], references: [id], onDelete: SetNull)
  primaryColor          String     @default("#4E92CF")
  primaryHoverColor     String     @default("#397FBF")
  primaryStrongColor    String     @default("#286FA9")
  primarySoftColor      String     @default("#EAF3FB")
  secondaryColor        String?
  defaultThemeMode      ThemeMode  @default(SYSTEM)
  customBrandingEnabled Boolean    @default(true)
  updatedById           String?    @db.Uuid
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
}

// =====================================================================================================================
// IDENTITY, AUTH, RBAC
// =====================================================================================================================

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  tenantId           String     @db.Uuid
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  username           String // staff/students: login name; guardians: E.164 phone
  phone              String?
  passwordHash       String // argon2id; reversible encryption is forbidden
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  mustChangePassword Boolean    @default(true)
  status             UserStatus @default(ACTIVE)
  authVersion        Int        @default(0) // bumped on role/password/status change → cached permissions refresh
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdById        String?    @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  preference UserPreference?
  sessions   AuthSession[]
  roles      UserRole[]      @relation("UserRoles")
  rolesGiven UserRole[]      @relation("UserRolesAssignedBy")
  student    Student?
  guardian   Guardian?
  employee   Employee?

  @@unique([tenantId, username])
  @@index([tenantId, phone])
}

model UserPreference {
  userId           String    @id @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeMode        ThemeMode @default(SYSTEM)
  sidebarCollapsed Boolean   @default(false)
  density          Density   @default(COMFORTABLE)
  locale           Locale?
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

// Refresh token family. Only SHA-256 hashes are stored. Rotation moves the old hash to previousTokenHash; a reused
// old token revokes the whole session.
model AuthSession {
  id                String     @id @default(uuid(7)) @db.Uuid
  tenantId          String     @db.Uuid
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId            String     @db.Uuid
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientType        ClientType
  refreshTokenHash  String     @unique
  previousTokenHash String?    @unique
  rotatedAt         DateTime?  @db.Timestamptz(3)
  expiresAt         DateTime   @db.Timestamptz(3)
  lastUsedAt        DateTime   @default(now()) @db.Timestamptz(3)
  userAgent         String?
  ipHash            String?
  revokedAt         DateTime?  @db.Timestamptz(3)
  revokeReason      String?
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId, revokedAt])
}

// Global catalogue (no tenant), synced from packages/shared/src/permissions.ts by the seed.
model Permission {
  code       String           @id
  module     String
  deprecated Boolean          @default(false)
  roles      RolePermission[]
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  archivedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
}

model RolePermission {
  roleId         String     @db.Uuid
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionCode String
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
}

model UserRole {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String    @db.Uuid
  user         User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  roleId       String    @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedById String?   @db.Uuid
  assignedBy   User?     @relation("UserRolesAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  // SQL: UserRole_active_unique — partial unique (userId, roleId) WHERE revokedAt IS NULL
  @@index([tenantId, userId])
}

// =====================================================================================================================
// INFRASTRUCTURE: AUDIT, FILES, IMPORT, IDEMPOTENCY, OUTBOX
// =====================================================================================================================

// Append-only (SQL trigger). Written in the same transaction as the change it records.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  reason      String?
  requestId   String?
  ipHash      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model FileAsset {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  storageKey   String     @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  kind         FileKind
  status       FileStatus @default(PENDING)
  createdById  String?    @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime?  @db.Timestamptz(3)

  brandingLogos    SchoolBranding[] @relation("BrandingLogo")
  brandingFavicons SchoolBranding[] @relation("BrandingFavicon")
  importJobs       ImportJob[]
  importResults    ImportJob[]      @relation("ImportResult")
  studentPhotos    Student[]

  questionImages QuestionVersion[]

  coinProductImages CoinProduct[]

  facePhotos FaceProfile[] @relation("FacePhoto")

  @@index([tenantId, kind, createdAt])
}

model ImportJob {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind          ImportKind
  status        ImportStatus @default(UPLOADED)
  fileAssetId   String       @db.Uuid
  fileAsset     FileAsset    @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  options       Json?
  summary       Json?
  errorCount    Int          @default(0)
  warningCount  Int          @default(0)
  failure       Json?
  // Credentials file produced by the commit (temporary passwords), downloadable once by the importing user.
  resultAssetId String?      @db.Uuid
  resultAsset   FileAsset?   @relation("ImportResult", fields: [resultAssetId], references: [id], onDelete: SetNull)
  createdById   String       @db.Uuid
  committedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  rows          ImportRow[]

  @@index([tenantId, kind, createdAt])
}

model ImportRow {
  id             String          @id @default(uuid(7)) @db.Uuid
  importJobId    String          @db.Uuid
  importJob      ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber      Int
  status         ImportRowStatus
  data           Json
  messages       Json
  targetEntityId String?

  @@unique([importJobId, rowNumber])
}

model IdempotencyRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String   @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String
  statusCode   Int
  responseBody Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)

  @@unique([tenantId, userId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
}

// =====================================================================================================================
// SCHOOL STRUCTURE
// =====================================================================================================================

// startDate/endDate: first and last school day (both inclusive).
model AcademicYear {
  id        String             @id @default(uuid(7)) @db.Uuid
  tenantId  String             @db.Uuid
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  classGroups        ClassGroup[]
  teachingGroups     TeachingGroup[]
  teacherAssignments TeacherAssignment[]
  enrollments        StudentEnrollment[]
  periods            AcademicPeriod[]
  schoolWeek         SchoolWeek?
  calendarDays       CalendarDay[]
  bellSchedules      BellSchedule[]
  timetables         Timetable[]
  lessonSessions     LessonSession[]
  curriculumPlans    CurriculumPlan[]
  scoreEntries       ScoreEntry[]

  // SQL: AcademicYear_one_active, AcademicYear_dates_check

  coinTransactions CoinTransaction[]

  @@unique([tenantId, name])
}

// Parallel (grade level), independent of the year.
model Grade {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  level      Int
  name       String
  archivedAt DateTime? @db.Timestamptz(3)

  classGroups     ClassGroup[]
  calendarDays    CalendarDayGrade[]
  topics          Topic[]
  curriculumPlans CurriculumPlan[]
  scoreEntries    ScoreEntry[]
  scoreLimitRules ScoreLimitRule[]

  questions Question[]
  tests     Test[]

  // SQL: Grade_level_check (0..11)
  @@unique([tenantId, level])
}

// A class in one academic year (7-A, 2026-2027).
model ClassGroup {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @db.Uuid
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId    String       @db.Uuid
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeId           String       @db.Uuid
  grade             Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section           String
  name              String
  homeroomTeacherId String?      @db.Uuid
  homeroomTeacher   Employee?    @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  capacity          Int?
  // Q-35: lesson times come from the shift's bell schedule (T-32)
  shiftId           String?      @db.Uuid
  shift             Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  archivedAt        DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  teachingGroups TeachingGroup[]
  enrollments    StudentEnrollment[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, academicYearId, gradeId])
}

model TeachingGroup {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String            @db.Uuid
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classGroupId   String?           @db.Uuid
  classGroup     ClassGroup?       @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  kind           TeachingGroupKind
  name           String
  subjectId      String?           @db.Uuid
  subject        Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  archivedAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  members            TeachingGroupMember[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  lessonSessions     LessonSession[]
  planAssignments    PlanAssignment[]
  scoreEntries       ScoreEntry[]
  scoreLimitRules    ScoreLimitRule[]

  testAssignments TestAssignment[]

  // SQL: TeachingGroup_one_class_group, TeachingGroup_class_check
  @@index([tenantId, academicYearId])
  @@index([classGroupId])
}

model TeachingGroupMember {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teachingGroupId String        @db.Uuid
  teachingGroup   TeachingGroup @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  studentId       String        @db.Uuid
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  validFrom       DateTime      @db.Date
  validTo         DateTime?     @db.Date

  // SQL: TeachingGroupMember_no_overlap (EXCLUDE), TeachingGroupMember_dates_check
  @@index([teachingGroupId, validFrom])
  @@index([studentId])
}

model Subject {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name       String
  shortName  String?
  code       String?
  colorKey   String?
  order      Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)

  teachingGroups         TeachingGroup[]
  teacherAssignments     TeacherAssignment[]
  timetableEntries       TimetableEntry[]
  lessonSessions         LessonSession[]
  topics                 Topic[]
  curriculumPlans        CurriculumPlan[]
  scoreEntries           ScoreEntry[]
  scoreLimitRules        ScoreLimitRule[]
  policyBindings         PolicyBinding[]
  manualAssessmentScores ManualAssessmentScore[]
  periodResults          PeriodResult[]

  questions Question[]
  tests     Test[]

  coinCriteria CoinCriterion[]

  @@unique([tenantId, name])
}

model Employee {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId        String?        @unique @db.Uuid
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode  String?
  firstName     String
  lastName      String
  middleName    String?
  phone         String?
  positionTitle String?
  status        EmployeeStatus @default(ACTIVE)
  hiredAt       DateTime?      @db.Date
  leftAt        DateTime?      @db.Date
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  homeroomClasses    ClassGroup[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  lessons            LessonSession[]     @relation("LessonTeacher")
  curriculumPlans    CurriculumPlan[]
  substituteLessons  LessonSession[]     @relation("LessonSubstitute")
  scoreEntries       ScoreEntry[]
  scoreLimitRules    ScoreLimitRule[]

  questions Question[]
  tests     Test[]

  coinCriteria     CoinCriterionTeacher[]
  coinLimitRules   CoinLimitRule[]
  coinTransactions CoinTransaction[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, lastName, firstName])
}

model TeacherAssignment {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId  String        @db.Uuid
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teacherId       String        @db.Uuid
  teacher         Employee      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  teachingGroupId String        @db.Uuid
  teachingGroup   TeachingGroup @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  subjectId       String        @db.Uuid
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  weeklyHours     Decimal?      @db.Decimal(4, 1)
  validFrom       DateTime      @db.Date
  validTo         DateTime?     @db.Date
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  // SQL: TeacherAssignment_dates_check
  @@unique([teachingGroupId, subjectId, teacherId, validFrom])
  @@index([tenantId, teacherId, academicYearId])
  @@index([tenantId, teachingGroupId, subjectId])
}

// No passport, birth certificate or INN fields — not collected (Q-29).
model Student {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String?       @unique @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentCode  String
  firstName    String
  lastName     String
  middleName   String?
  dateOfBirth  DateTime?     @db.Date
  gender       Gender?
  phone        String?
  address      String?
  notes        String?
  status       StudentStatus @default(ACTIVE)
  photoAssetId String?       @db.Uuid
  photoAsset   FileAsset?    @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  guardians              StudentGuardian[]
  enrollments            StudentEnrollment[]
  groupMemberships       TeachingGroupMember[]
  lessonAttendance       LessonAttendance[]
  scoreEntries           ScoreEntry[]
  manualAssessmentScores ManualAssessmentScore[]
  periodResults          PeriodResult[]

  testAssignments     TestAssignment[]
  testWindowOverrides TestWindowOverride[]
  testAttempts        TestAttempt[]
  offlineResults      OfflineResult[]

  coinAccount      CoinAccount?
  coinTransactions CoinTransaction[]
  coinOrders       CoinOrder[]

  accessEvents      AccessEvent[]
  attendanceRecords AttendanceRecord[]
  faceProfile       FaceProfile[]
  faceSyncJobs      FaceSyncJob[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @db.Uuid
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String?           @unique @db.Uuid
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String
  middleName String?
  phone      String // E.164 (+998XXXXXXXXX)
  notes      String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  students   StudentGuardian[]

  @@index([tenantId, phone])
}

model StudentGuardian {
  id                    String           @id @default(uuid(7)) @db.Uuid
  tenantId              String           @db.Uuid
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId             String           @db.Uuid
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardianId            String           @db.Uuid
  guardian              Guardian         @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  relation              GuardianRelation
  isPrimary             Boolean          @default(false)
  canViewData           Boolean          @default(true)
  receivesNotifications Boolean          @default(true)
  revokedAt             DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([studentId, guardianId])
  @@index([tenantId, guardianId])
}

model StudentEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String           @db.Uuid
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId String           @db.Uuid
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classGroupId   String           @db.Uuid
  classGroup     ClassGroup       @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  status         EnrollmentStatus @default(ACTIVE)
  validFrom      DateTime         @db.Date
  validTo        DateTime?        @db.Date
  reason         String?
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  // SQL: StudentEnrollment_one_active, StudentEnrollment_dates_check
  @@index([tenantId, classGroupId, status])
  @@index([studentId, academicYearId])
}

// =====================================================================================================================
// M2 — CALENDAR (docs/spec/lesson-plan.md §2)
// =====================================================================================================================

// Quarter / half / year / custom. Lessons belong to the smallest period containing their date (T-29).
model AcademicPeriod {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String               @db.Uuid
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  type           AcademicPeriodType
  name           String
  order          Int
  startDate      DateTime             @db.Date
  endDate        DateTime             @db.Date
  parentId       String?              @db.Uuid
  parent         AcademicPeriod?      @relation("PeriodHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       AcademicPeriod[]     @relation("PeriodHierarchy")
  status         AcademicPeriodStatus @default(DRAFT)
  closedAt       DateTime?            @db.Timestamptz(3)
  closedById     String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  lessonSessions         LessonSession[]
  planItems              PlanItem[]
  scoreEntries           ScoreEntry[]
  policyBindings         PolicyBinding[]
  manualAssessmentScores ManualAssessmentScore[]
  periodResults          PeriodResult[]
  periodCloseRuns        PeriodCloseRun[]

  tests Test[]

  // SQL: AcademicPeriod_dates_check, AcademicPeriod_no_overlap (same type)
  @@unique([academicYearId, type, order])
  @@index([tenantId, academicYearId])
}

model SchoolWeek {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @db.Uuid
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId  String       @unique @db.Uuid
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  // ISO weekdays 1..7, e.g. [1,2,3,4,5,6] (Q-02 default)
  workingWeekdays Int[]
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  // SQL: SchoolWeek_weekdays_check
}

// Holiday, vacation, non-working day, a working day that follows another weekday's timetable, or a shortened day.
model CalendarDay {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @db.Uuid
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String             @db.Uuid
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  date           DateTime           @db.Date
  kind           CalendarDayKind
  title          String
  // WORKING_OVERRIDE: whose weekday's timetable runs that day (ISO 1..7)
  followsWeekday Int?
  appliesToAll   Boolean            @default(true)
  grades         CalendarDayGrade[]
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  // SQL: CalendarDay_override_check
  @@unique([academicYearId, date])
}

model CalendarDayGrade {
  calendarDayId String      @db.Uuid
  calendarDay   CalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)
  gradeId       String      @db.Uuid
  grade         Grade       @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@id([calendarDayId, gradeId])
}

model Shift {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  // minutes from midnight, school time zone (08:30 → 510)
  startMinute Int
  endMinute   Int
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  classGroups   ClassGroup[]
  bellSchedules BellSchedule[]

  // SQL: Shift_minutes_check
  @@unique([tenantId, name])
}

// Bell times; a change is a new schedule with a later validFrom (old lessons keep their times).
model BellSchedule {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  shiftId        String?      @db.Uuid
  shift          Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  name           String
  validFrom      DateTime     @db.Date
  slots          BellSlot[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([academicYearId, shiftId, validFrom])
}

model BellSlot {
  id             String       @id @default(uuid(7)) @db.Uuid
  bellScheduleId String       @db.Uuid
  bellSchedule   BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)
  lessonNumber   Int
  startMinute    Int
  endMinute      Int

  // SQL: BellSlot_minutes_check
  @@unique([bellScheduleId, lessonNumber])
}

model Room {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name       String
  capacity   Int?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  timetableEntries TimetableEntry[]

  @@unique([tenantId, name])
}

// =====================================================================================================================
// M2 — TIMETABLE (lesson-plan.md §2). A published version never changes; a change is a new version from a later date.
// =====================================================================================================================

model Timetable {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String           @db.Uuid
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  version        Int
  status         TimetableStatus  @default(DRAFT)
  // Set when published; validTo is set when a later version takes over (inclusive).
  validFrom      DateTime?        @db.Date
  validTo        DateTime?        @db.Date
  note           String?
  createdById    String           @db.Uuid
  publishedById  String?          @db.Uuid
  publishedAt    DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  entries        TimetableEntry[]

  // SQL: Timetable_published_check, Timetable_no_overlap (published versions of a year)
  @@unique([academicYearId, version])
  @@index([tenantId, academicYearId])
}

model TimetableEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Entries are replaced only while the timetable is a DRAFT (service rule; published entries are frozen).
  timetableId     String          @db.Uuid
  timetable       Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  teachingGroupId String          @db.Uuid
  teachingGroup   TeachingGroup   @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  subjectId       String          @db.Uuid
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId       String          @db.Uuid
  teacher         Employee        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  roomId          String?         @db.Uuid
  room            Room?           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  // ISO 1..7
  weekday         Int
  lessonNumber    Int
  weekType        WeekType        @default(ALL)
  lessonSessions  LessonSession[]

  // SQL: TimetableEntry_slot_check
  @@index([timetableId, teachingGroupId])
  @@index([timetableId, teacherId, weekday, lessonNumber])
}

// =====================================================================================================================
// M2 — LESSON SESSIONS (lesson-plan.md §3). A concrete lesson on a school date. Never deleted: a lesson the timetable
// drops becomes CANCELLED; HELD or locked lessons are never changed by regeneration.
// =====================================================================================================================

model LessonSession {
  id                  String              @id @default(uuid(7)) @db.Uuid
  tenantId            String              @db.Uuid
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId      String              @db.Uuid
  academicYear        AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  periodId            String              @db.Uuid
  period              AcademicPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  teachingGroupId     String              @db.Uuid
  teachingGroup       TeachingGroup       @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  subjectId           String              @db.Uuid
  subject             Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId           String              @db.Uuid
  teacher             Employee            @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  // Q-40 (T-33): who actually teaches it this time
  substituteTeacherId String?             @db.Uuid
  substituteTeacher   Employee?           @relation("LessonSubstitute", fields: [substituteTeacherId], references: [id], onDelete: Restrict)
  // schoolDate
  date                DateTime            @db.Date
  lessonNumber        Int
  startsAt            DateTime            @db.Timestamptz(3)
  endsAt              DateTime            @db.Timestamptz(3)
  // order of this group + subject's lessons in the year (1, 2, 3 …), cancelled ones excluded
  sequenceNo          Int
  status              LessonSessionStatus @default(SCHEDULED)
  source              LessonSessionSource @default(TIMETABLE)
  timetableEntryId    String?             @db.Uuid
  timetableEntry      TimetableEntry?     @relation(fields: [timetableEntryId], references: [id], onDelete: Restrict)
  // the planned topic (lesson-plan.md §4.4); fixed once the lesson is held or in the past
  planItemId          String?             @db.Uuid
  planItem            PlanItem?           @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  actualTopicNote     String?
  heldMarkedAt        DateTime?           @db.Timestamptz(3)
  heldMarkedById      String?             @db.Uuid
  // Set when cancelled by hand; regeneration cancels without a reason (and may bring the lesson back)
  cancelReason        String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  attendance          LessonAttendance[]
  scoreEntries        ScoreEntry[]

  // SQL: LessonSession_times_check, LessonSession_no_delete
  @@unique([teachingGroupId, date, lessonNumber])
  @@index([tenantId, teacherId, date])
  @@index([tenantId, substituteTeacherId, date])
  @@index([teachingGroupId, subjectId, sequenceNo])
  @@index([periodId, teachingGroupId, subjectId])
  @@index([academicYearId, date])
}

// =====================================================================================================================
// M2 — CURRICULUM PLANS (lesson-plan.md §4). A plan is a template for a subject + grade; versions share a lineage.
// Only a DRAFT (or REJECTED) version is edited; an APPROVED one is changed through a new version.
// =====================================================================================================================

// A topic is its own object: scores (M3), questions (M4) and AI feedback refer to it.
model Topic {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subjectId       String    @db.Uuid
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId         String    @db.Uuid
  grade           Grade     @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  title           String
  // packages/shared normalizeText(title): import matching
  normalizedTitle String
  code            String?
  parentTopicId   String?   @db.Uuid
  parentTopic     Topic?    @relation("TopicTree", fields: [parentTopicId], references: [id], onDelete: Restrict)
  children        Topic[]   @relation("TopicTree")
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  planItems    PlanItem[]
  scoreEntries ScoreEntry[]

  questions Question[]

  @@unique([tenantId, subjectId, gradeId, normalizedTitle])
}

model CurriculumPlan {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // shared by every version of one plan
  lineageId      String               @db.Uuid
  version        Int
  academicYearId String               @db.Uuid
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subjectId      String               @db.Uuid
  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId        String               @db.Uuid
  grade          Grade                @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  // the teacher who wrote it (null when written by an administrator without an employee record)
  authorId       String?              @db.Uuid
  author         Employee?            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdById    String               @db.Uuid
  title          String
  status         CurriculumPlanStatus @default(DRAFT)
  submittedAt    DateTime?            @db.Timestamptz(3)
  approvedById   String?              @db.Uuid
  approvedAt     DateTime?            @db.Timestamptz(3)
  rejectionNote  String?
  sourceImportId String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  items       PlanItem[]
  assignments PlanAssignment[]

  // SQL: CurriculumPlan_one_open, CurriculumPlan_one_approved (per lineage)
  @@unique([lineageId, version])
  @@index([tenantId, academicYearId, subjectId, gradeId])
}

model PlanItem {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @db.Uuid
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // replaced as a whole while the plan is editable (SQL trigger PlanItem_frozen otherwise)
  planId     String          @db.Uuid
  plan       CurriculumPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  order      Int
  periodId   String?         @db.Uuid
  period     AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  topicId    String          @db.Uuid
  topic      Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  hours      Int
  lessonType LessonType      @default(NEW)
  objectives String?
  homework   String?
  resources  String?
  notes      String?

  lessonSessions LessonSession[]

  tests Test[]

  // SQL: PlanItem_hours_check, PlanItem_frozen
  @@unique([planId, order])
}

// A plan template applied to one group: its topics are placed on that group's lessons of the plan's subject.
model PlanAssignment {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @db.Uuid
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId          String               @db.Uuid
  plan            CurriculumPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  teachingGroupId String               @db.Uuid
  teachingGroup   TeachingGroup        @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  // copy of plan.subjectId for the partial unique index
  subjectId       String               @db.Uuid
  status          PlanAssignmentStatus @default(ACTIVE)
  appliedAt       DateTime             @default(now()) @db.Timestamptz(3)
  appliedById     String               @db.Uuid
  endedAt         DateTime?            @db.Timestamptz(3)

  // SQL: PlanAssignment_one_active — one active plan per group and subject
  @@index([planId])
  @@index([teachingGroupId, subjectId])
}

// =====================================================================================================================
// M3 — scoring (docs/spec/scoring.md)
// =====================================================================================================================

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
}

enum ScoreEntryKind {
  NORMAL
  REVERSAL
}

enum ScoreLimitWindow {
  LESSON
  DAY
  WEEK
  MONTH
  PERIOD
}

enum ScoreLimitScope {
  GLOBAL
  SUBJECT
  GRADE
  TEACHER
  TEACHING_GROUP
  CRITERION
}

model ScoreCriterion {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  // Bounds of one entry under this criterion (T-77); null = only the general limits apply.
  minPoints   Decimal? @db.Decimal(8, 2)
  maxPoints   Decimal? @db.Decimal(8, 2)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  scoreEntries ScoreEntry[]
  limitRules   ScoreLimitRule[]

  @@unique([tenantId, name])
}

// One current mark per student and lesson; every change is in AuditLog (scoring.md §2).
model LessonAttendance {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lessonSessionId String           @db.Uuid
  lessonSession   LessonSession    @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  studentId       String           @db.Uuid
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status          AttendanceStatus
  note            String?
  markedById      String           @db.Uuid
  markedAt        DateTime         @db.Timestamptz(3)

  @@unique([lessonSessionId, studentId])
  @@index([tenantId, studentId])
}

// LEDGER: insert only (SQL trigger rejects UPDATE/DELETE). A correction is a REVERSAL (negative) + a new NORMAL.
model ScoreEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String          @db.Uuid
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // who teaches the lesson (the substitute when there is one)
  teacherId       String          @db.Uuid
  teacher         Employee        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subjectId       String          @db.Uuid
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teachingGroupId String          @db.Uuid
  teachingGroup   TeachingGroup   @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  // the student's grade at the time (GRADE limits)
  gradeId         String          @db.Uuid
  grade           Grade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  lessonSessionId String          @db.Uuid
  lessonSession   LessonSession   @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  // copied from the lesson's plan item
  topicId         String?         @db.Uuid
  topic           Topic?          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  academicYearId  String          @db.Uuid
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  periodId        String          @db.Uuid
  period          AcademicPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  // = the lesson's date, never the time of writing
  schoolDate      DateTime        @db.Date
  criterionId     String?         @db.Uuid
  criterion       ScoreCriterion? @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  // NORMAL > 0, REVERSAL < 0 (SQL CHECK)
  points          Decimal         @db.Decimal(8, 2)
  note            String?
  kind            ScoreEntryKind  @default(NORMAL)
  reversesEntryId String?         @unique @db.Uuid
  reversesEntry   ScoreEntry?     @relation("ScoreReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      ScoreEntry?     @relation("ScoreReversal")
  // required on a REVERSAL by a teacher after lateEntryDays or by someone else (service), reason column free text
  reason          String?
  idempotencyKey  String
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  // SQL: ScoreEntry_kind_check, ScoreEntry_append_only
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, studentId, schoolDate])
  @@index([lessonSessionId, studentId])
  @@index([periodId, subjectId, studentId])
  @@index([teacherId, schoolDate])
}

model ScoreLimitRule {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  window          ScoreLimitWindow
  scopeType       ScoreLimitScope
  // One column per scope type instead of a polymorphic id, for foreign keys. All null = the default of the type.
  subjectId       String?          @db.Uuid
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId         String?          @db.Uuid
  grade           Grade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  teacherId       String?          @db.Uuid
  teacher         Employee?        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  teachingGroupId String?          @db.Uuid
  teachingGroup   TeachingGroup?   @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  criterionId     String?          @db.Uuid
  criterion       ScoreCriterion?  @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  maxPoints       Decimal          @db.Decimal(8, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  // SQL: ScoreLimitRule_scope_check, ScoreLimitRule_one_active (partial unique)
  @@index([tenantId, window, scopeType, isActive])
  @@index([criterionId])
}

// Q-06, Q-07 defaults.
model ScoreSettings {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @unique @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hardCapPerLesson   Decimal  @default(10) @db.Decimal(8, 2)
  hardCapPerDay      Decimal  @default(70) @db.Decimal(8, 2)
  lessonMaxPoints    Decimal  @default(10) @db.Decimal(8, 2)
  allowScoreOnAbsent Boolean  @default(false)
  lateEntryDays      Int      @default(3)
  updatedById        String?  @db.Uuid
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PeriodResultStatus {
  DRAFT
  FINAL
}

enum PeriodCloseRunStatus {
  PREPARED
  CLOSED
  CANCELLED
}

model AssessmentPolicy {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  versions AssessmentPolicyVersion[]

  // SQL: AssessmentPolicy_one_default (partial unique)
  @@unique([tenantId, name])
}

// A PUBLISHED version never changes (SQL trigger); a change is a new version. config = AssessmentConfigSchema (zod).
model AssessmentPolicyVersion {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policyId      String              @db.Uuid
  policy        AssessmentPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  version       Int
  status        PolicyVersionStatus @default(DRAFT)
  config        Json
  configHash    String
  note          String?
  createdById   String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  publishedById String?             @db.Uuid
  publishedAt   DateTime?           @db.Timestamptz(3)

  bindings      PolicyBinding[]
  periodResults PeriodResult[]

  // SQL: AssessmentPolicyVersion_one_draft (partial unique), AssessmentPolicyVersion_frozen
  @@unique([policyId, version])
}

model PolicyBinding {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @db.Uuid
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  periodId        String                  @db.Uuid
  period          AcademicPeriod          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  // null = every subject
  subjectId       String?                 @db.Uuid
  subject         Subject?                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  policyVersionId String                  @db.Uuid
  policyVersion   AssessmentPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  boundAt         DateTime                @default(now()) @db.Timestamptz(3)
  boundById       String?                 @db.Uuid
  // "apply to the current period" closes the old binding (history stays)
  supersededAt    DateTime?               @db.Timestamptz(3)
  reason          String?

  // SQL: PolicyBinding_one_current (partial unique)
  @@index([periodId])
}

model GradeScale {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @db.Uuid
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  bands     GradeScaleBand[]

  @@unique([tenantId, name])
}

model GradeScaleBand {
  id         String     @id @default(uuid(7)) @db.Uuid
  scaleId    String     @db.Uuid
  scale      GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  minPercent Decimal    @db.Decimal(5, 2)
  maxPercent Decimal    @db.Decimal(5, 2)
  label      String
  order      Int

  // SQL: GradeScaleBand_range_check
  @@unique([scaleId, order])
}

// MANUAL component input (scoring.md §5.1, Q-12). History kept: a correction is a new row, the old one superseded.
model ManualAssessmentScore {
  id             String                  @id @default(uuid(7)) @db.Uuid
  tenantId       String                  @db.Uuid
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  periodId       String                  @db.Uuid
  period         AcademicPeriod          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subjectId      String                  @db.Uuid
  subject        Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  studentId      String                  @db.Uuid
  student        Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  componentKey   String
  points         Decimal                 @db.Decimal(8, 2)
  maxPoints      Decimal                 @db.Decimal(8, 2)
  note           String?
  enteredById    String                  @db.Uuid
  enteredAt      DateTime                @default(now()) @db.Timestamptz(3)
  supersededById String?                 @db.Uuid
  supersededBy   ManualAssessmentScore?  @relation("ManualScoreHistory", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes     ManualAssessmentScore[] @relation("ManualScoreHistory")

  // SQL: ManualAssessmentScore_points_check, ManualAssessmentScore_one_current (partial unique)
  @@index([periodId, subjectId])
  @@index([supersededById])
}

// FINAL rows never change (SQL trigger, except the stale flag); a recomputation is a new version.
model PeriodResult {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @db.Uuid
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String                  @db.Uuid
  student         Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // null = the overall result over all subjects
  subjectId       String?                 @db.Uuid
  subject         Subject?                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  periodId        String                  @db.Uuid
  period          AcademicPeriod          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  policyVersionId String                  @db.Uuid
  policyVersion   AssessmentPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  status          PeriodResultStatus      @default(DRAFT)
  version         Int
  isCurrent       Boolean                 @default(true)
  isComplete      Boolean                 @default(true)
  isStale         Boolean                 @default(false)
  components      Json
  totalPoints     Decimal?                @db.Decimal(10, 4)
  maxPoints       Decimal                 @db.Decimal(8, 2)
  // full precision; rounding only for display
  percent         Decimal?                @db.Decimal(9, 6)
  displayPercent  Decimal?                @db.Decimal(5, 2)
  gradeLabel      String?
  inputsHash      String
  computedAt      DateTime                @db.Timestamptz(3)
  finalizedById   String?                 @db.Uuid
  finalizedAt     DateTime?               @db.Timestamptz(3)

  // SQL: PeriodResult_one_current (partial unique), PeriodResult_final_frozen
  @@index([tenantId, periodId, subjectId])
  @@index([studentId, periodId])
}

model PeriodCloseRun {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @db.Uuid
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  periodId     String               @db.Uuid
  period       AcademicPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  status       PeriodCloseRunStatus @default(PREPARED)
  report       Json
  preparedById String               @db.Uuid
  preparedAt   DateTime             @default(now()) @db.Timestamptz(3)
  closedById   String?              @db.Uuid
  closedAt     DateTime?            @db.Timestamptz(3)

  @@index([periodId])
}

// ---------------------------------------------------------------------------------------------------------------
// M4 tests (docs/spec/tests.md). A question version used in a test never changes (an edit is a new version);
// offline results keep their history (supersededById); attempts are graded on the server only.

enum QuestionType {
  SINGLE
  MULTIPLE
  SHORT_TEXT
  MATCHING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  ACTIVE
  ARCHIVED
}

enum TestFormat {
  ONLINE
  OFFLINE
}

enum TestPurpose {
  PRACTICE
  WEIGHTED
}

enum TestStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum TestResultVisibility {
  IMMEDIATE
  AFTER_CLOSE
  NEVER
}

enum MultipleScoring {
  ALL_OR_NOTHING
  PARTIAL
}

enum TestRetakePolicy {
  LAST
  BEST
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
}

enum AttemptFinishReason {
  SUBMITTED
  TIME_UP
  VIOLATION
  ADMIN_CLOSED
}

enum TestEventType {
  VISIBILITY_HIDDEN
  VISIBILITY_VISIBLE
  BLUR
  FOCUS
  RECONNECT
}

enum OfflineResultStatus {
  SCORED
  ABSENT
  EXCUSED
}

model TestType {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tests Test[]

  @@unique([tenantId, code])
}

model Question {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ownerId           String             @db.Uuid
  owner             Employee           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subjectId         String             @db.Uuid
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId           String             @db.Uuid
  grade             Grade              @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  topicId           String?            @db.Uuid
  topic             Topic?             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  type              QuestionType
  difficulty        QuestionDifficulty @default(MEDIUM)
  status            QuestionStatus     @default(ACTIVE)
  currentVersionId  String?            @unique @db.Uuid
  currentVersion    QuestionVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  sharedWithSubject Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  archivedAt        DateTime?          @db.Timestamptz(3)

  versions QuestionVersion[]

  @@index([tenantId, subjectId, gradeId, status])
  @@index([ownerId])
}

// Append-only (SQL trigger QuestionVersion_append_only).
model QuestionVersion {
  id              String     @id @default(uuid(7)) @db.Uuid
  tenantId        String     @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  questionId      String     @db.Uuid
  question        Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version         Int
  text            String
  imageAssetId    String?    @db.Uuid
  imageAsset      FileAsset? @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)
  points          Decimal    @default(1) @db.Decimal(6, 2)
  /// [{ id, text, isCorrect }] — option ids are stable inside the version
  options         Json       @default("[]")
  /// SHORT_TEXT: string[]
  acceptedAnswers Json?
  /// MATCHING: [{ leftId, left, rightId, right }]
  pairs           Json?
  explanation     String?
  contentHash     String
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)

  currentOf     Question?      @relation("CurrentVersion")
  testQuestions TestQuestion[]

  // SQL: QuestionVersion_points_check
  @@unique([questionId, version])
  @@index([tenantId, contentHash])
}

model Test {
  id                   String               @id @default(uuid(7)) @db.Uuid
  tenantId             String               @db.Uuid
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title                String
  description          String?
  subjectId            String               @db.Uuid
  subject              Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId              String               @db.Uuid
  grade                Grade                @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  teacherId            String               @db.Uuid
  teacher              Employee             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  testTypeId           String               @db.Uuid
  testType             TestType             @relation(fields: [testTypeId], references: [id], onDelete: Restrict)
  format               TestFormat
  purpose              TestPurpose
  status               TestStatus           @default(DRAFT)
  startsAt             DateTime?            @db.Timestamptz(3)
  endsAt               DateTime?            @db.Timestamptz(3)
  /// The school day of the test (OFFLINE: when it was written; ONLINE: the day it opens), Asia/Tashkent
  schoolDate           DateTime?            @db.Date
  timeLimitMinutes     Int?
  questionCount        Int?
  shuffleQuestions     Boolean              @default(true)
  shuffleOptions       Boolean              @default(true)
  /// { mode: "MANUAL" } | { mode: "POOL", rules: [{ topicId, difficulty, count }] }
  selection            Json                 @default("{\"mode\":\"MANUAL\"}")
  maxScore             Decimal              @default(0) @db.Decimal(8, 2)
  multipleScoring      MultipleScoring      @default(ALL_OR_NOTHING)
  periodId             String?              @db.Uuid
  period               AcademicPeriod?      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  weight               Decimal?             @db.Decimal(6, 2)
  includedInAssessment Boolean              @default(true)
  retakePolicy         TestRetakePolicy     @default(LAST)
  violationThreshold   Int                  @default(3)
  showResultToStudent  TestResultVisibility @default(AFTER_CLOSE)
  planItemId           String?              @db.Uuid
  planItem             PlanItem?            @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  createdById          String?              @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  publishedAt          DateTime?            @db.Timestamptz(3)
  closedAt             DateTime?            @db.Timestamptz(3)

  questions      TestQuestion[]
  assignments    TestAssignment[]
  overrides      TestWindowOverride[]
  attempts       TestAttempt[]
  offlineResults OfflineResult[]

  // SQL: Test_window_check, Test_weighted_check, Test_offline_scale_check, Test_threshold_check
  @@index([tenantId, subjectId, gradeId, status])
  @@index([teacherId])
  @@index([periodId])
}

model TestQuestion {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testId            String          @db.Uuid
  test              Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  order             Int
  points            Decimal         @db.Decimal(6, 2)

  answers TestAnswer[]

  @@unique([testId, order])
  @@unique([testId, questionVersionId])
}

model TestAssignment {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testId          String         @db.Uuid
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  teachingGroupId String?        @db.Uuid
  teachingGroup   TeachingGroup? @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)
  studentId       String?        @db.Uuid
  student         Student?       @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // SQL: TestAssignment_target_check (exactly one target)
  @@unique([testId, teachingGroupId])
  @@unique([testId, studentId])
}

model TestWindowOverride {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testId           String   @db.Uuid
  test             Test     @relation(fields: [testId], references: [id], onDelete: Restrict)
  studentId        String   @db.Uuid
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  startsAt         DateTime @db.Timestamptz(3)
  endsAt           DateTime @db.Timestamptz(3)
  timeLimitMinutes Int?
  reason           String
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  // SQL: TestWindowOverride_window_check
  @@index([testId, studentId])
}

model TestAttempt {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testId         String               @db.Uuid
  test           Test                 @relation(fields: [testId], references: [id], onDelete: Restrict)
  studentId      String               @db.Uuid
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attemptNo      Int
  status         AttemptStatus        @default(IN_PROGRESS)
  finishReason   AttemptFinishReason?
  startedAt      DateTime             @default(now()) @db.Timestamptz(3)
  deadline       DateTime?            @db.Timestamptz(3)
  finishedAt     DateTime?            @db.Timestamptz(3)
  currentIndex   Int                  @default(0)
  /// TestQuestion ids in the order this student sees them
  questionOrder  Json
  /// { [testQuestionId]: optionId[] } (MATCHING: right-side ids)
  optionOrder    Json
  violationCount Int                  @default(0)
  score          Decimal?             @db.Decimal(8, 2)
  maxScore       Decimal              @db.Decimal(8, 2)
  percent        Decimal?             @db.Decimal(7, 4)
  gradedAt       DateTime?            @db.Timestamptz(3)
  /// The school day the attempt started (Asia/Tashkent)
  schoolDate     DateTime             @db.Date

  answers TestAnswer[]
  events  TestEvent[]

  // SQL: TestAttempt_one_in_progress (partial unique), TestAttempt_finish_check
  @@unique([testId, studentId, attemptNo])
  @@index([studentId, status])
}

model TestAnswer {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attemptId      String       @db.Uuid
  attempt        TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  testQuestionId String       @db.Uuid
  testQuestion   TestQuestion @relation(fields: [testQuestionId], references: [id], onDelete: Restrict)
  /// { optionIds: string[] } | { text: string } | { pairs: [{ leftId, rightId }] }
  answer         Json
  savedAt        DateTime     @default(now()) @db.Timestamptz(3)
  clientSeq      Int
  isCorrect      Boolean?
  pointsAwarded  Decimal?     @db.Decimal(6, 2)

  @@unique([attemptId, testQuestionId])
}

model TestEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attemptId String        @db.Uuid
  attempt   TestAttempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  type      TestEventType
  clientTs  DateTime?     @db.Timestamptz(3)
  serverTs  DateTime      @default(now()) @db.Timestamptz(3)
  clientSeq Int?
  counted   Boolean       @default(false)

  @@index([attemptId, serverTs])
}

model OfflineResult {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testId         String              @db.Uuid
  test           Test                @relation(fields: [testId], references: [id], onDelete: Restrict)
  studentId      String              @db.Uuid
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rawScore       Decimal?            @db.Decimal(8, 2)
  status         OfflineResultStatus
  note           String?
  enteredById    String              @db.Uuid
  enteredAt      DateTime            @default(now()) @db.Timestamptz(3)
  supersededById String?             @db.Uuid
  supersededBy   OfflineResult?      @relation("OfflineResultHistory", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes     OfflineResult[]     @relation("OfflineResultHistory")

  // SQL: OfflineResult_score_check, OfflineResult_one_current (partial unique)
  @@index([testId, studentId])
  @@index([supersededById])
}

// =====================================================================================================================
// M5 — COIN (MASTER_SPEC §14). Coins are whole numbers and never mix with academic scores.
// =====================================================================================================================

enum CoinCriterionType {
  REWARD
  PENALTY
  BOTH
}

enum CoinEligibility {
  ALL_TEACHERS
  SELECTED_TEACHERS
}

enum CoinTxType {
  REWARD
  PENALTY
  PURCHASE
  REFUND
  ADMIN_ADJUSTMENT
  REVERSAL
  CORRECTION
}

enum CoinTxSource {
  TEACHER_CRITERION
  ATTENDANCE
  TEST_RESULT
  ADMIN_ADJUST
  SHOP_PURCHASE
  REFUND
  OTHER
}

enum CoinLimitScope {
  GLOBAL
  CRITERION
  TEACHER
  TEACHER_CRITERION
  EACH_CRITERION
  EACH_TEACHER
  EACH_TEACHER_CRITERION
}

enum CoinLimitPeriod {
  DAY
  WEEK
  MONTH
  ROLLING
}

enum CoinDirection {
  REWARD
  PENALTY
}

enum CoinOrderStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
  CANCELLED
}

enum CoinAutoSource {
  TEST_RESULT
  ATTENDANCE // connected after M6
}

/// Every part of the coin system can be switched off (§14). Q-24: no debt by default.
model CoinSettings {
  id                       String   @id @default(uuid(7)) @db.Uuid
  tenantId                 String   @unique @db.Uuid
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  isEnabled                Boolean  @default(true)
  rewardsEnabled           Boolean  @default(true)
  penaltiesEnabled         Boolean  @default(true)
  teacherEvaluationEnabled Boolean  @default(true)
  adminAdjustmentEnabled   Boolean  @default(true)
  autoCoinsEnabled         Boolean  @default(true)
  shopEnabled              Boolean  @default(true)
  newOrdersEnabled         Boolean  @default(true)
  orderApprovalRequired    Boolean  @default(true)
  allowNegativeBalance     Boolean  @default(false)
  /// With debt allowed: the deepest balance is −maxDebt (null = no floor).
  maxDebt                  Int?
  activityWindowDays       Int      @default(7)
  /// % of the teacher's students evaluated within the window
  activityMinCoverage      Int      @default(30)
  activityStaleDays        Int      @default(3)
  updatedById              String?  @db.Uuid
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
  // SQL: CoinSettings_check
}

model CoinCriterion {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  type        CoinCriterionType
  minAmount   Int
  maxAmount   Int
  /// Only teachers of this subject, only for its students
  subjectId   String?           @db.Uuid
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Q-25: selected teachers by default
  eligibility CoinEligibility   @default(SELECTED_TEACHERS)
  /// Used by automatic rules only — teachers cannot pick it
  isAutomatic Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  teachers     CoinCriterionTeacher[]
  limitRules   CoinLimitRule[]
  transactions CoinTransaction[]
  autoRules    CoinAutoRule[]

  // SQL: CoinCriterion_amount_check
  @@unique([tenantId, name])
}

model CoinCriterionTeacher {
  tenantId    String        @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  criterionId String        @db.Uuid
  criterion   CoinCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  teacherId   String        @db.Uuid
  teacher     Employee      @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([criterionId, teacherId])
  @@index([teacherId])
}

model CoinLimitRule {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @db.Uuid
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scope                CoinLimitScope
  criterionId          String?         @db.Uuid
  criterion            CoinCriterion?  @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  teacherId            String?         @db.Uuid
  teacher              Employee?       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  /// null = both types
  type                 CoinDirection?
  period               CoinLimitPeriod
  /// ROLLING only
  durationMinutes      Int?
  maxAmount            Int?
  maxCount             Int?
  countTypesSeparately Boolean         @default(false)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  // SQL: CoinLimitRule_check
  @@index([tenantId, isActive])
}

/// Balance cache and the lock point of a student's coins. Changed only together with a ledger row; the daily
/// reconciliation compares it with the ledger sum.
model CoinAccount {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId String   @unique @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// LEDGER: insert only. A mistake is undone by a REVERSAL or lowered by a CORRECTION row.
model CoinTransaction {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenantId              String            @db.Uuid
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId             String            @db.Uuid
  student               Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  type                  CoinTxType
  source                CoinTxSource
  /// Signed: + credit, − debit
  amount                Int
  balanceAfter          Int
  /// The school day (Asia/Tashkent) — limits and reports go by it
  schoolDate            DateTime          @db.Date
  academicYearId        String            @db.Uuid
  academicYear          AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  criterionId           String?           @db.Uuid
  criterion             CoinCriterion?    @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  criterionNameSnapshot String?
  /// The evaluating teacher (REWARD/PENALTY from a teacher; their reversals and corrections keep it for reports)
  teacherId             String?           @db.Uuid
  teacher               Employee?         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  actorUserId           String?           @db.Uuid
  orderId               String?           @db.Uuid
  order                 CoinOrder?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reversesTransactionId String?           @unique @db.Uuid
  reversesTransaction   CoinTransaction?  @relation("CoinReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy            CoinTransaction?  @relation("CoinReversal")
  correctsTransactionId String?           @db.Uuid
  correctsTransaction   CoinTransaction?  @relation("CoinCorrection", fields: [correctsTransactionId], references: [id], onDelete: Restrict)
  corrections           CoinTransaction[] @relation("CoinCorrection")
  /// Automatic coins: e.g. "test:<testId>" — never awarded twice
  sourceRef             String?
  reason                String?
  idempotencyKey        String
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)

  // SQL: CoinTransaction_append_only, CoinTransaction_shape_check
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, studentId, source, sourceRef])
  @@index([tenantId, studentId, schoolDate])
  @@index([tenantId, teacherId, schoolDate])
  @@index([tenantId, type, schoolDate])
  @@index([criterionId])
  @@index([correctsTransactionId])
  @@index([orderId])
}

model CoinProduct {
  id           String      @id @default(uuid(7)) @db.Uuid
  tenantId     String      @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  imageAssetId String?     @db.Uuid
  imageAsset   FileAsset?  @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  price        Int
  stock        Int         @default(0)
  isVisible    Boolean     @default(true)
  archivedAt   DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  orders       CoinOrder[]

  // SQL: CoinProduct_check
  @@index([tenantId, archivedAt])
}

model CoinOrder {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @db.Uuid
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId           String            @db.Uuid
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  productId           String            @db.Uuid
  product             CoinProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  priceAtOrder        Int
  status              CoinOrderStatus   @default(PENDING)
  note                String?
  processedById       String?           @db.Uuid
  approvedAt          DateTime?         @db.Timestamptz(3)
  deliveredAt         DateTime?         @db.Timestamptz(3)
  closedAt            DateTime?         @db.Timestamptz(3)
  idempotencyKey      String
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  transactions        CoinTransaction[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([studentId, createdAt])
}

/// Automatic coin rule (TEST_RESULT now; ATTENDANCE after M6). config: zod schema in packages/shared.
model CoinAutoRule {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  source      CoinAutoSource
  criterionId String         @db.Uuid
  criterion   CoinCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  config      Json
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([tenantId, source, isActive])
}

// ======================================================================
// M6 — Face ID and school attendance (MASTER_SPEC §11)
// ======================================================================

enum DeviceDirection {
  IN
  OUT
  BOTH
}

enum EventDirection {
  IN
  OUT
}

enum AccessEventSource {
  WEBHOOK // pushed by the terminal (directly or relayed by the bridge)
  HISTORY // read back from the terminal's event log after an outage
}

enum SchoolAttendanceStatus {
  PRESENT
  LATE
}

enum ManualAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum FaceSyncAction {
  UPSERT
  DELETE
}

enum FaceSyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
}

enum BridgeJobType {
  FACE_UPSERT
  FACE_DELETE
  FACE_CHECK
  DEVICE_INFO
  EVENT_HISTORY
}

enum BridgeJobStatus {
  QUEUED
  LEASED
  DONE
  FAILED
}

/// One row per school. Missing row = defaults (attendance-config.ts).
model AttendanceSettings {
  tenantId            String   @id @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  isEnabled           Boolean  @default(false)
  // used when the student's class has no shift; minutes from midnight, school time zone
  defaultStartMinute  Int      @default(510)
  defaultEndMinute    Int      @default(810)
  graceMinutes        Int      @default(0)
  // ISAPI minor event types that count as a verified pass (75 = face)
  acceptedSubEvents   Int[]    @default([75])
  maxClockSkewSeconds Int      @default(300)
  maxEventAgeDays     Int      @default(7)
  deviceStaleSeconds  Int      @default(180)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  // SQL: AttendanceSettings_check
}

model LatenessBand {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name       String
  // [fromMinute, toMinute) minutes late; toMinute null = no upper bound
  fromMinute Int
  toMinute   Int?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  records AttendanceRecord[]

  // SQL: LatenessBand_check
  @@index([tenantId, fromMinute])
}

/// Local agent in the school network (Windows service). Authenticates with a bearer token (only its hash is stored);
/// rotation keeps the previous hash valid for a short overlap.
model BridgeAgent {
  id                     String    @id @default(uuid(7)) @db.Uuid
  tenantId               String    @db.Uuid
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                   String
  tokenHash              String    @unique
  previousTokenHash      String?   @unique
  previousTokenExpiresAt DateTime? @db.Timestamptz(3)
  tokenRotatedAt         DateTime  @default(now()) @db.Timestamptz(3)
  version                String?
  hostname               String?
  queueDepth             Int?
  lastSeenAt             DateTime? @db.Timestamptz(3)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  devices Device[]
  jobs    BridgeJob[]

  @@unique([tenantId, name])
}

/// Hikvision terminal. Identified by serial number first (MASTER_SPEC §11); its webhook key is stored hashed.
model Device {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  serialNumber   String?
  ipAddress      String?
  port           Int             @default(80)
  username       String?
  // AES-256-GCM with DATA_ENCRYPTION_KEY (crypto.ts); never returned by the API
  passwordEnc    String?
  direction      DeviceDirection
  location       String?
  useBridge      Boolean         @default(true)
  bridgeAgentId  String?         @db.Uuid
  bridgeAgent    BridgeAgent?    @relation(fields: [bridgeAgentId], references: [id], onDelete: SetNull)
  webhookKeyHash String          @unique
  isActive       Boolean         @default(true)
  model          String?
  firmware       String?
  lastSeenAt     DateTime?       @db.Timestamptz(3)
  lastEventAt    DateTime?       @db.Timestamptz(3)
  lastError      String?
  archivedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  events    AccessEvent[]
  faceSyncs FaceSyncJob[]
  jobs      BridgeJob[]

  // SQL: Device_port_check
  @@unique([tenantId, name])
  @@unique([tenantId, serialNumber])
}

/// Raw access event from a terminal. Append-only; (deviceId, eventKey) makes repeated pushes idempotent.
model AccessEvent {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deviceId         String            @db.Uuid
  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  eventKey         String
  occurredAt       DateTime          @db.Timestamptz(3)
  schoolDate       DateTime          @db.Date
  employeeNo       String
  // null = employeeNo matched no student (kept for the Face Check page)
  studentId        String?           @db.Uuid
  student          Student?          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  direction        EventDirection?
  attendanceStatus String?
  majorEventType   Int
  subEventType     Int
  source           AccessEventSource @default(WEBHOOK)
  receivedAt       DateTime          @default(now()) @db.Timestamptz(3)

  // SQL: AccessEvent_append_only trigger
  @@unique([deviceId, eventKey])
  @@index([tenantId, studentId, schoolDate])
  @@index([tenantId, schoolDate])
}

/// SCHOOL_ATTENDANCE: one row per student and school day, recomputed from AccessEvent; a manual mark is stored beside
/// the device result (both kept). LESSON_ATTENDANCE stays in LessonAttendance (teacher).
model AttendanceRecord {
  id                String                  @id @default(uuid(7)) @db.Uuid
  tenantId          String                  @db.Uuid
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String                  @db.Uuid
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  schoolDate        DateTime                @db.Date
  firstInAt         DateTime?               @db.Timestamptz(3)
  lastOutAt         DateTime?               @db.Timestamptz(3)
  // null = no arrival recorded by a device
  deviceStatus      SchoolAttendanceStatus?
  lateMinutes       Int                     @default(0)
  latenessBandId    String?                 @db.Uuid
  latenessBand      LatenessBand?           @relation(fields: [latenessBandId], references: [id], onDelete: Restrict)
  earlyLeaveMinutes Int                     @default(0)
  manualStatus      ManualAttendanceStatus?
  manualReason      String?
  manualById        String?                 @db.Uuid
  manualAt          DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)

  // SQL: AttendanceRecord_check
  @@unique([tenantId, studentId, schoolDate])
  @@index([tenantId, schoolDate])
}

/// The face photo that is sent to terminals (separate from the profile photo). Stored encrypted (FileKind.FACE_PHOTO).
model FaceProfile {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId    String     @db.Uuid
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  photoAssetId String?    @db.Uuid
  photoAsset   FileAsset? @relation("FacePhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)
  // increases with every new photo; a device is in sync when it holds this version
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, studentId])
}

/// Sync state of one student's face on one device (the current state; history in AuditLog).
model FaceSyncJob {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deviceId      String         @db.Uuid
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  studentId     String         @db.Uuid
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  action        FaceSyncAction
  status        FaceSyncStatus @default(PENDING)
  // FaceProfile.version this job sends (UPSERT)
  version       Int?
  syncedVersion Int?
  attempts      Int            @default(0)
  lastError     String?
  lastCheckedAt DateTime?      @db.Timestamptz(3)
  // result of the last "check on device": true = the device holds a face for the student
  deviceHasFace Boolean?
  syncedAt      DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  jobs BridgeJob[]

  @@unique([deviceId, studentId])
  @@index([tenantId, status])
}

/// Work for a bridge (or the worker, for directly reachable devices). Leased by polling; a lease expires.
model BridgeJob {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @db.Uuid
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bridgeAgentId String?         @db.Uuid
  bridgeAgent   BridgeAgent?    @relation(fields: [bridgeAgentId], references: [id], onDelete: SetNull)
  deviceId      String          @db.Uuid
  device        Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  faceSyncId    String?         @db.Uuid
  faceSync      FaceSyncJob?    @relation(fields: [faceSyncId], references: [id], onDelete: SetNull)
  type          BridgeJobType
  payload       Json
  status        BridgeJobStatus @default(QUEUED)
  attempts      Int             @default(0)
  leasedUntil   DateTime?       @db.Timestamptz(3)
  result        Json?
  error         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?       @db.Timestamptz(3)

  @@index([bridgeAgentId, status, createdAt])
  @@index([tenantId, deviceId, status])
}
